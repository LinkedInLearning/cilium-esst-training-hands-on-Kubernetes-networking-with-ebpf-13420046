{
  "name": "Cilium Essential Training",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  // 4-core / 16 GB is the minimum for a 3-node kind cluster running Cilium.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    // Docker-in-Docker so kind can run Kubernetes nodes as containers.
    // kubectl, Helm, kind and the Cilium/Hubble CLIs are installed by
    // install-tools.sh from the pinned versions in containerEnv below.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  },
  // Single source of truth for the course toolchain versions. Bump here to update
  // the whole environment (install-tools.sh and the kind node image read these).
  "containerEnv": {
    "CILIUM_VERSION": "1.20.1",
    "CILIUM_CLI_VERSION": "v0.20.0",
    "HUBBLE_VERSION": "v1.19.4",
    "HELM_VERSION": "v3.22.0",
    "KUBECTL_VERSION": "v1.36.4",
    "KIND_VERSION": "v0.33.0"
  },
  // Set the terminal prompt to '$ ' for clean on-screen recording.
  "onCreateCommand": "echo PS1='\"$ \"' >> ~/.bashrc",
  // Install kind, the Cilium CLI and the Hubble CLI (not covered by features).
  "postCreateCommand": "bash .devcontainer/install-tools.sh"
}
// DevContainer Reference: https://code.visualstudio.com/docs/remote/devcontainerjson-reference